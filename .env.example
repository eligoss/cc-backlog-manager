# Agentic Framework - Telemetry Configuration
# Copy this file to .env and customize for your environment

# ============================================================================
# MASTER TELEMETRY CONTROL
# ============================================================================

# Enable/disable all telemetry (default: true)
TELEMETRY_ENABLED=true

# Log level: debug, info, warn, error (default: info)
TELEMETRY_LEVEL=info

# ============================================================================
# EXPORTERS
# ============================================================================

# --- JSON File Exporter ---
# Enable JSONL file export (default: true)
TELEMETRY_JSON_ENABLED=true

# Output file path (default: .claude/telemetry/events.jsonl)
TELEMETRY_JSON_PATH=.claude/telemetry/events.jsonl

# --- Session File Exporter ---
# Enable session-specific files (default: true)
TELEMETRY_SESSION_FILE_ENABLED=true

# Session files directory (default: .claude/telemetry/sessions)
TELEMETRY_SESSION_FILE_DIR=.claude/telemetry/sessions

# Max session files to keep (default: 50)
TELEMETRY_SESSION_FILE_MAX_FILES=50

# Max age of session files in days (default: 7)
TELEMETRY_SESSION_FILE_MAX_AGE_DAYS=7

# --- OpenTelemetry (OTLP) Exporter ---
# Enable OTLP export to observability platforms (default: false)
TELEMETRY_OTEL_ENABLED=false

# OTLP endpoint URL (default: http://localhost:4318)
# Examples:
#   - Local collector: http://localhost:4318
#   - Honeycomb: https://api.honeycomb.io
#   - Datadog: https://trace.agent.datadoghq.com
#   - Grafana Cloud: https://otlp-gateway-prod-us-east-0.grafana.net/otlp
TELEMETRY_OTEL_ENDPOINT=http://localhost:4318

# Service name for OTLP traces (default: agentic-framework)
TELEMETRY_OTEL_SERVICE_NAME=agentic-framework

# OTLP headers (JSON string for API keys, auth tokens, etc.)
# Examples:
#   - Honeycomb: {"x-honeycomb-team":"YOUR_API_KEY"}
#   - Datadog: {"DD-API-KEY":"YOUR_API_KEY"}
#   - Grafana: {"Authorization":"Basic YOUR_TOKEN"}
# TELEMETRY_OTEL_HEADERS={"x-api-key":"YOUR_KEY"}

# --- Console Exporter (Development) ---
# Enable console output for development debugging (default: false)
TELEMETRY_CONSOLE_ENABLED=false

# Pretty-print events with colors and formatting (default: true)
TELEMETRY_CONSOLE_PRETTY=true

# Enable colors in console output (default: true)
TELEMETRY_CONSOLE_COLORS=true

# Console log level: debug, info, warn, error (default: info)
TELEMETRY_CONSOLE_LEVEL=info

# ============================================================================
# INSTRUMENTATION (What to Track)
# ============================================================================

# Track discovery operations (agent skill matching) (default: true)
TELEMETRY_INSTR_DISCOVERY=true

# Track sync operations (file processing) (default: true)
TELEMETRY_INSTR_SYNC=true

# Track CLI commands (default: true)
TELEMETRY_INSTR_CLI=true

# Track MCP operations (Model Context Protocol tool calls) (default: true)
TELEMETRY_INSTR_MCP=true

# Track Claude agent/command executions (slash commands, agents, subagents)
# ⚠️ OPT-IN for privacy - tracks Claude Code commands and agent invocations
# Captures: /ai-architect, /ai-app-developer, Task tool subagents, etc.
# (default: false - must explicitly enable)
TELEMETRY_INSTR_AGENT=false

# ============================================================================
# SESSION TRACKING
# ============================================================================

# Enable session tracking (correlates events across a session) (default: true)
TELEMETRY_SESSION_ENABLED=true

# Include machine identifier in session context (default: false)
TELEMETRY_SESSION_MACHINE_ID=false

# ============================================================================
# EXAMPLES: Common Configurations
# ============================================================================

# Development - Console output only, all instrumentation enabled
# TELEMETRY_CONSOLE_ENABLED=true
# TELEMETRY_JSON_ENABLED=false
# TELEMETRY_OTEL_ENABLED=false
# TELEMETRY_INSTR_AGENT=true

# Production - OTLP export to Honeycomb, minimal instrumentation
# TELEMETRY_CONSOLE_ENABLED=false
# TELEMETRY_JSON_ENABLED=true
# TELEMETRY_OTEL_ENABLED=true
# TELEMETRY_OTEL_ENDPOINT=https://api.honeycomb.io
# TELEMETRY_OTEL_HEADERS={"x-honeycomb-team":"YOUR_API_KEY"}
# TELEMETRY_INSTR_AGENT=false

# Privacy-first - Disabled telemetry
# TELEMETRY_ENABLED=false

# Local analysis - JSONL only, all instrumentation
# TELEMETRY_CONSOLE_ENABLED=false
# TELEMETRY_JSON_ENABLED=true
# TELEMETRY_OTEL_ENABLED=false
# TELEMETRY_INSTR_DISCOVERY=true
# TELEMETRY_INSTR_SYNC=true
# TELEMETRY_INSTR_CLI=true
# TELEMETRY_INSTR_MCP=true
# TELEMETRY_INSTR_AGENT=true
