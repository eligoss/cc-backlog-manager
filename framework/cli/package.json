{
  "name": "cc-agentic-framework",
  "version": "1.18.0",
  "description": "CLI for scaffolding and managing Agentic Development Framework projects",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agentic-framework": "./bin/agentic-framework",
    "agentic-framework-mcp": "./bin/mcp-server"
  },
  "scripts": {
    "prebuild": "node scripts/prepare-publish.js",
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "jest",
    "test:unit": "jest",
    "test:integration": "jest --config jest.integration.config.cjs",
    "test:e2e": "jest --config jest.e2e.config.cjs",
    "test:integration:debug": "TEST_KEEP_ON_FAILURE=true TEST_VERBOSE=true jest --config jest.integration.config.cjs",
    "test:all": "jest",
    "validate": "node dist/index.js validate -p ..",
    "validate:strict": "node dist/index.js validate -p .. --strict",
    "validate:versions": "node dist/index.js validate -p .. --versions",
    "update-docs": "tsx scripts/update-documentation.ts",
    "prepublishOnly": "npm run build",
    "postpublish": "node scripts/cleanup-build.js"
  },
  "keywords": [
    "ai",
    "agents",
    "claude",
    "framework",
    "scaffolding",
    "cli"
  ],
  "author": "Agentic Framework Team",
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.76",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-metrics": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/sdk-trace-node": "^2.6.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.13.6",
    "chalk": "^5.3.0",
    "commander": "14.0.3",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.3.1",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.3.4",
    "glob": "13.0.6",
    "gray-matter": "^4.0.3",
    "inquirer": "^13.3.2",
    "ora": "^9.3.0",
    "yaml": "^2.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.0",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-jest-mock-import-meta": "^1.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "bin",
    "framework"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eligoss/agentic-development-framework.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
