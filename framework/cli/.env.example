# =============================================================================
# Agentic Framework CLI - Environment Variables
# =============================================================================
# Copy this file to .env and customize as needed.
# Environment variables override telemetry.config.json settings.
# =============================================================================

# -----------------------------------------------------------------------------
# TELEMETRY - Core Settings
# -----------------------------------------------------------------------------

# Enable/disable telemetry collection (default: true)
# TELEMETRY_ENABLED=true

# Log level: debug | info | warn | error (default: info)
# TELEMETRY_LEVEL=info

# -----------------------------------------------------------------------------
# TELEMETRY - Session Tracking
# -----------------------------------------------------------------------------
# Sessions allow correlating all events from a single CLI invocation,
# making it easy to distinguish parallel agent runs.

# Enable/disable session tracking (default: true)
# TELEMETRY_SESSION_ENABLED=true

# Include hashed machine identifier in session context (default: false)
# TELEMETRY_SESSION_MACHINE_ID=false

# -----------------------------------------------------------------------------
# TELEMETRY - JSON File Exporter
# -----------------------------------------------------------------------------
# Writes all telemetry events to a single JSONL file.

# Enable/disable JSON file exporter (default: true)
# TELEMETRY_JSON_ENABLED=true

# Path to the JSONL events file (default: .claude/telemetry/events.jsonl)
# TELEMETRY_JSON_PATH=.claude/telemetry/events.jsonl

# -----------------------------------------------------------------------------
# TELEMETRY - Session File Exporter
# -----------------------------------------------------------------------------
# Writes events to per-session JSONL files for easy parallel run distinction.

# Enable/disable session file exporter (default: true)
# TELEMETRY_SESSION_FILE_ENABLED=true

# Directory for session log files (default: .claude/telemetry/sessions)
# TELEMETRY_SESSION_FILE_DIR=.claude/telemetry/sessions

# Maximum number of session files to keep (default: 50)
# TELEMETRY_SESSION_FILE_MAX_FILES=50

# Maximum age of session files in days (default: 7)
# TELEMETRY_SESSION_FILE_MAX_AGE_DAYS=7

# -----------------------------------------------------------------------------
# TELEMETRY - OpenTelemetry Exporter
# -----------------------------------------------------------------------------
# Exports telemetry to an OpenTelemetry collector for enterprise observability.

# Enable/disable OpenTelemetry exporter (default: false)
# TELEMETRY_OTEL_ENABLED=false

# OpenTelemetry collector endpoint (default: http://localhost:4318)
# TELEMETRY_OTEL_ENDPOINT=http://localhost:4318

# Service name for OpenTelemetry (default: agentic-framework)
# TELEMETRY_OTEL_SERVICE_NAME=agentic-framework

# -----------------------------------------------------------------------------
# TELEMETRY - Instrumentation
# -----------------------------------------------------------------------------
# Control which operations are instrumented.

# Enable/disable discovery operation instrumentation (default: true)
# TELEMETRY_INSTR_DISCOVERY=true

# Enable/disable sync operation instrumentation (default: true)
# TELEMETRY_INSTR_SYNC=true

# Enable/disable CLI command instrumentation (default: true)
# TELEMETRY_INSTR_CLI=true

# -----------------------------------------------------------------------------
# JIRA Integration (if jira module installed)
# -----------------------------------------------------------------------------

# Jira base URL
# JIRA_BASE_URL=https://your-domain.atlassian.net

# Jira API token (create at https://id.atlassian.com/manage-profile/security/api-tokens)
# JIRA_API_TOKEN=your-api-token

# Jira account email
# JIRA_EMAIL=your-email@example.com

# -----------------------------------------------------------------------------
# Confluence Integration (if confluence module installed)
# -----------------------------------------------------------------------------

# Confluence base URL
# CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki

# Confluence API token (same as Jira if using Atlassian Cloud)
# CONFLUENCE_API_TOKEN=your-api-token

# Confluence account email (falls back to JIRA_EMAIL if not set)
# CONFLUENCE_EMAIL=your-email@example.com

# -----------------------------------------------------------------------------
# CI/CD Environment
# -----------------------------------------------------------------------------

# Set automatically by CI systems (GitHub Actions, Jenkins, etc.)
# Used to adjust behavior in CI environments
# CI=true
