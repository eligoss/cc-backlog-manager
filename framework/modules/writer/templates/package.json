{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "description": "Fantasy book project built with Agentic Framework Writer module",
  "private": true,
  "scripts": {
    "build": "node -r tsx/register ./node_modules/@agentic-framework/cli/dist/writer/build.js",
    "build:watch": "npm run build -- --watch",
    "analyze": "node -r tsx/register ./node_modules/@agentic-framework/cli/dist/writer/analyze.js",
    "export": "node -r tsx/register ./node_modules/@agentic-framework/cli/dist/writer/export.js",
    "export:md": "npm run export -- --format md",
    "export:html": "npm run export -- --format html",
    "validate": "npx agentic-framework writer validate",
    "validate:immutability": "npx agentic-framework writer validate-immutability",
    "context": "npx agentic-framework writer generate-context"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "vite": "^5.0.0",
    "yaml": "^2.3.4",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
