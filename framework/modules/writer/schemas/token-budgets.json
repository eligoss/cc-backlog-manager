{
  "$schema": "./token-budgets.schema.json",
  "version": "1.0.0",

  "defaults": {
    "scene-writing": {
      "total": 2000,
      "allocation": {
        "immediate-context": 200,
        "chapter-summary": 150,
        "world-facts": 400,
        "character-context": 400,
        "style-guidance": 200,
        "prerequisites": 150,
        "active-threads": 100,
        "reserve": 400
      }
    },
    "chapter-planning": {
      "total": 3000,
      "allocation": {
        "part-context": 300,
        "chapter-arc": 400,
        "scene-summaries": 500,
        "character-states": 500,
        "world-facts": 600,
        "style-guidance": 200,
        "foreshadowing": 200,
        "reserve": 300
      }
    },
    "part-planning": {
      "total": 5000,
      "allocation": {
        "baseline": 500,
        "part-arc": 600,
        "chapter-summaries": 800,
        "character-arcs": 800,
        "world-facts-full": 1000,
        "themes": 400,
        "style-guidance": 300,
        "reserve": 600
      }
    }
  },

  "world-fact-priorities": {
    "core": 1,
    "magic": 2,
    "geography": 3,
    "characters": 4,
    "history": 5,
    "factions": 6,
    "artifacts": 7,
    "languages": 8,
    "calendars": 9
  },

  "summary-requirements": {
    "world-fact": {
      "max-summary-tokens": 100,
      "required-for-token-count-over": 300
    },
    "character": {
      "max-summary-tokens": 80,
      "required-for-token-count-over": 200
    }
  },

  "context-levels": {
    "minimal": {
      "name": "minimal",
      "max-tokens": 500,
      "sections": [
        "immediate",
        "pov-voice-summary",
        "active-tensions"
      ]
    },
    "scene": {
      "name": "scene",
      "max-tokens": 1500,
      "sections": [
        "immediate",
        "pov-voice",
        "chapter-summary",
        "world-facts-summary",
        "style-guidance"
      ]
    },
    "chapter": {
      "name": "chapter",
      "max-tokens": 2500,
      "sections": [
        "immediate",
        "pov-voice",
        "chapter-full",
        "part-summary",
        "world-facts",
        "characters-present",
        "foreshadowing"
      ]
    },
    "part": {
      "name": "part",
      "max-tokens": 4000,
      "sections": [
        "baseline-summary",
        "part-full",
        "chapter-summaries",
        "character-arcs",
        "world-facts-full",
        "themes"
      ]
    },
    "full": {
      "name": "full",
      "max-tokens": 6000,
      "sections": [
        "baseline-full",
        "part-full",
        "chapter-full",
        "all-characters",
        "all-world-facts",
        "style-full"
      ]
    }
  }
}
