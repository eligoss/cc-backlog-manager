{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-framework.dev/schemas/writer/world-lock.schema.json",
  "title": "World Lock Schema",
  "description": "Schema for world.lock.json - hash registry for immutability enforcement",
  "type": "object",
  "required": [
    "version",
    "created",
    "immutable-facts",
    "append-only-facts",
    "expandable-facts"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version of the world lock file format"
    },
    "created": {
      "type": "string",
      "format": "date",
      "description": "Date when world lock file was created"
    },
    "last-updated": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last update to this lock file"
    },
    "immutable-facts": {
      "type": "object",
      "description": "Registry of immutable facts with their locked hashes",
      "additionalProperties": {
        "type": "object",
        "required": ["hash", "established", "file"],
        "properties": {
          "hash": {
            "type": "string",
            "description": "SHA-256 hash of the locked content"
          },
          "established": {
            "type": "string",
            "format": "date",
            "description": "Date when this fact was established"
          },
          "file": {
            "type": "string",
            "description": "Relative path to the fact file"
          },
          "category": {
            "type": "string",
            "description": "Category of the fact"
          },
          "version": {
            "type": "string",
            "description": "Current version of the fact"
          }
        }
      }
    },
    "append-only-facts": {
      "type": "object",
      "description": "Registry of append-only facts with original and addition hashes",
      "additionalProperties": {
        "type": "object",
        "required": ["original-hash", "current-version", "established"],
        "properties": {
          "original-hash": {
            "type": "string",
            "description": "SHA-256 hash of the original locked content"
          },
          "current-version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Current version number (increments with additions)"
          },
          "established": {
            "type": "string",
            "format": "date",
            "description": "Date when original content was established"
          },
          "file": {
            "type": "string",
            "description": "Relative path to the fact file"
          },
          "category": {
            "type": "string",
            "description": "Category of the fact"
          },
          "additions": {
            "type": "array",
            "description": "Array of additions made to this fact",
            "items": {
              "type": "object",
              "required": ["date", "hash"],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date",
                  "description": "Date when addition was made"
                },
                "hash": {
                  "type": "string",
                  "description": "SHA-256 hash of the added content"
                },
                "section": {
                  "type": "string",
                  "description": "Section title or identifier"
                },
                "description": {
                  "type": "string",
                  "description": "Description of the addition"
                }
              }
            }
          }
        }
      }
    },
    "expandable-facts": {
      "type": "object",
      "description": "Registry of expandable facts with expansion tracking",
      "additionalProperties": {
        "type": "object",
        "required": ["original-hash", "established"],
        "properties": {
          "original-hash": {
            "type": "string",
            "description": "SHA-256 hash of the original parent content"
          },
          "current-version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Current version number"
          },
          "established": {
            "type": "string",
            "format": "date",
            "description": "Date when parent fact was established"
          },
          "file": {
            "type": "string",
            "description": "Relative path to the parent fact file"
          },
          "category": {
            "type": "string",
            "description": "Category of the fact"
          },
          "expansions": {
            "type": "array",
            "description": "Array of sub-items added as expansions",
            "items": {
              "type": "string",
              "description": "ID of the expanded fact"
            }
          }
        }
      }
    },
    "validation-rules": {
      "type": "object",
      "description": "Validation rules for pre-commit hooks",
      "properties": {
        "prevent-modification": {
          "type": "boolean",
          "description": "Block commits that modify immutable facts",
          "default": true
        },
        "require-hash-match": {
          "type": "boolean",
          "description": "Require hash verification before allowing commits",
          "default": true
        },
        "audit-all-changes": {
          "type": "boolean",
          "description": "Log all changes to world facts in audit trail",
          "default": true
        },
        "validate-dependencies": {
          "type": "boolean",
          "description": "Validate that all depends-on facts exist",
          "default": true
        },
        "update-token-counts": {
          "type": "boolean",
          "description": "Automatically update token counts on commit",
          "default": true
        }
      }
    },
    "audit-trail": {
      "type": "array",
      "description": "Audit log of all world fact modifications",
      "items": {
        "type": "object",
        "required": ["timestamp", "fact-id", "action"],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "When the action occurred"
          },
          "fact-id": {
            "type": "string",
            "description": "ID of the affected fact"
          },
          "action": {
            "type": "string",
            "enum": [
              "created",
              "locked",
              "unlocked",
              "modified",
              "addition",
              "expansion",
              "validated"
            ],
            "description": "Type of action performed"
          },
          "old-hash": {
            "type": "string",
            "description": "Previous hash (for modifications)"
          },
          "new-hash": {
            "type": "string",
            "description": "New hash (for modifications)"
          },
          "reason": {
            "type": "string",
            "description": "Reason for the change (required for unlocks)"
          },
          "affected-books": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Books that may be affected by this change"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
