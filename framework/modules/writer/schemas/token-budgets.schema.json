{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Token Budgets Configuration Schema",
  "description": "Schema for token budget configuration file",
  "type": "object",
  "required": ["version", "defaults"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "defaults": {
      "type": "object",
      "properties": {
        "scene-writing": {
          "$ref": "#/definitions/budgetAllocation"
        },
        "chapter-planning": {
          "$ref": "#/definitions/budgetAllocation"
        },
        "part-planning": {
          "$ref": "#/definitions/budgetAllocation"
        }
      }
    },
    "world-fact-priorities": {
      "type": "object",
      "description": "Priority order for loading world facts (lower = higher priority)",
      "additionalProperties": { "type": "integer" }
    },
    "summary-requirements": {
      "type": "object",
      "properties": {
        "world-fact": {
          "type": "object",
          "properties": {
            "max-summary-tokens": { "type": "integer" },
            "required-for-token-count-over": { "type": "integer" }
          }
        },
        "character": {
          "type": "object",
          "properties": {
            "max-summary-tokens": { "type": "integer" },
            "required-for-token-count-over": { "type": "integer" }
          }
        }
      }
    },
    "context-levels": {
      "type": "object",
      "properties": {
        "minimal": { "$ref": "#/definitions/contextLevel" },
        "scene": { "$ref": "#/definitions/contextLevel" },
        "chapter": { "$ref": "#/definitions/contextLevel" },
        "part": { "$ref": "#/definitions/contextLevel" },
        "full": { "$ref": "#/definitions/contextLevel" }
      }
    }
  },
  "definitions": {
    "budgetAllocation": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 500,
          "maximum": 10000
        },
        "allocation": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        }
      }
    },
    "contextLevel": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "max-tokens": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        },
        "sections": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
