{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Prerequisites Schema",
  "description": "Schema for narrative prerequisites in parts, chapters, and scenes",
  "type": "object",
  "properties": {
    "baseline": {
      "type": "string",
      "description": "ID of baseline document (for parts)"
    },
    "requires-parts": {
      "type": "array",
      "items": { "type": "integer" },
      "description": "Part numbers that must be complete before this part"
    },
    "requires-chapters": {
      "type": "array",
      "items": { "type": "integer" },
      "description": "Chapter numbers in current part that must be complete"
    },
    "part": {
      "type": "integer",
      "description": "Parent part number (for chapters)"
    },
    "chapter": {
      "type": "integer",
      "description": "Parent chapter number (for scenes)"
    },
    "prior-scene": {
      "type": ["string", "null"],
      "description": "Filename of immediately prior scene"
    },
    "prior-state": {
      "type": "object",
      "properties": {
        "last-scene": { "type": "string" },
        "time-since": { "type": "string" },
        "location": { "type": "string" }
      }
    },
    "world-state": {
      "type": "object",
      "description": "World state changes at this point",
      "properties": {
        "time-elapsed": { "type": "string" },
        "location-shift": { "type": "string" },
        "date": { "type": "string" },
        "era": { "type": "string" }
      }
    },
    "character-states": {
      "type": "object",
      "description": "State of each character at this point",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "physical": { "type": "string" },
          "emotional": { "type": "string" },
          "location": { "type": "string" },
          "status": { "type": "string" },
          "knows": {
            "type": "array",
            "items": { "type": "string" }
          },
          "doesnt-know": {
            "type": "array",
            "items": { "type": "string" }
          },
          "current-goal": { "type": "string" },
          "knowledge-gained-last-chapter": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "required-threads": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Plot threads that must be established"
    },
    "active-tensions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Unresolved tensions active at this point"
    },
    "world-elements-required": {
      "type": "array",
      "items": { "type": "string" },
      "description": "World fact IDs needed for this section"
    },
    "relevant-world-facts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "World fact IDs relevant to this scene"
    },
    "reader-knows": {
      "type": "array",
      "items": { "type": "string" },
      "description": "What the reader knows at this point"
    },
    "immediate": {
      "type": "object",
      "description": "Immediate scene context",
      "properties": {
        "time": { "type": "string" },
        "location": { "type": "string" },
        "weather": { "type": "string" },
        "lighting": { "type": "string" }
      }
    },
    "characters-present": {
      "type": "array",
      "description": "Characters in this scene",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "state": { "type": "string" },
          "position": { "type": "string" }
        }
      }
    },
    "sensory": {
      "type": "object",
      "description": "Sensory context for the scene",
      "properties": {
        "dominant": { "type": "string" },
        "secondary": { "type": "string" },
        "ambient": { "type": "string" }
      }
    },
    "mood": {
      "type": "string",
      "description": "Overall mood of scene"
    },
    "tension-level": {
      "type": "string",
      "enum": ["low", "medium", "high", "extreme"],
      "description": "Tension level for pacing"
    },
    "pov-state": {
      "type": "object",
      "description": "POV character's internal state",
      "properties": {
        "current-thought": { "type": "string" },
        "current-fear": { "type": "string" },
        "physical-sensation": { "type": "string" }
      }
    },
    "token-budget": {
      "type": "object",
      "description": "Token limits for context loading",
      "properties": {
        "full": { "type": "integer" },
        "full-context": { "type": "integer" },
        "summary": { "type": "integer" },
        "summary-context": { "type": "integer" },
        "scene-context": { "type": "integer" },
        "chapter-context": { "type": "integer" },
        "max-context": { "type": "integer" },
        "world-facts": { "type": "integer" },
        "character-context": { "type": "integer" },
        "immediate-setting": { "type": "integer" },
        "style-guidance": { "type": "integer" },
        "remaining-for-prose": { "type": "integer" }
      }
    }
  }
}
