{
  "$schema": "./registries/schemas/module.schema.json",
  "id": "core",
  "version": "1.0.0",
  "name": "Framework Core",
  "description": "Core framework infrastructure including framework management agents, shared skills, and essential utilities",
  "provides": {
    "agents": [
      "ai-framework-manager",
      "ai-framework-developer",
      "ai-scout-backlog",
      "ai-scout-codebase",
      "ai-scout-knowledge"
    ],
    "skills": [
      "committing-code",
      "verifying-quality",
      "validating-markdown",
      "using-mcp",
      "building-skills",
      "using-framework",
      "validating-links",
      "building-framework",
      "building-agents",
      "gathering-intelligence",
      "knowing-the-codebase",
      "knowing-the-domain",
      "knowing-backlog"
    ],
    "capabilities": [
      "framework-governance",
      "git-workflow-management",
      "jira-integration",
      "jira-git-integration",
      "jira-branch-workflow",
      "quality-assurance",
      "markdown-formatting",
      "mcp-tool-usage",
      "skill-creation",
      "framework-architecture-knowledge",
      "link-validation",
      "agent-design",
      "framework-development",
      "planning-phases",
      "intelligence-gathering",
      "codebase-knowledge",
      "domain-knowledge",
      "backlog-knowledge"
    ],
    "scripts": [],
    "guards": [],
    "cli-commands": [
      "init",
      "add",
      "remove",
      "list",
      "info",
      "update",
      "status",
      "sync",
      {
        "name": "agent list",
        "type": "query",
        "description": "List all SDK-enabled agents"
      },
      {
        "name": "agent show",
        "type": "query",
        "description": "Show SDK definition for an agent"
      },
      {
        "name": "agent run",
        "type": "execute",
        "description": "Run an agent with Claude Agent SDK"
      }
    ]
  },
  "requires": {},
  "optional-dependencies": [],
  "entry-points": {
    "hooks": {
      "pre-commit": [
        "agentic-framework build --quick",
        "agentic-framework sync --skills --check",
        "agentic-framework sync --agents --check"
      ]
    },
    "claude-hooks": {
      "SessionStart": [
        {
          "matcher": "startup",
          "scripts": [
            "session-start-worktree.sh",
            "session-start-context.sh"
          ]
        },
        {
          "matcher": "compact",
          "scripts": [
            "session-compact-context.sh"
          ]
        }
      ],
      "SessionEnd": [
        {
          "matcher": ".*",
          "scripts": [
            "session-end-reminder.sh"
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Write|Edit",
          "scripts": [
            "pre-write-quality.sh"
          ]
        },
        {
          "matcher": "Bash",
          "scripts": [
            "pre-commit-skill-reminder.sh",
            "pre-bash-safety.sh"
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Write|Edit",
          "scripts": [
            "post-write-validate.sh",
            "post-write-format.sh"
          ]
        }
      ],
      "SubagentStart": [
        {
          "matcher": ".*",
          "scripts": [
            "skill-reminder.sh"
          ]
        }
      ],
      "Stop": [
        {
          "matcher": ".*",
          "scripts": [
            "stop-quality-check.sh",
            "stop-commit-check.sh",
            "stop-pr-suggest.sh"
          ]
        }
      ],
      "Notification": [
        {
          "matcher": "permission_prompt|idle_prompt",
          "scripts": [
            "notify.sh"
          ]
        }
      ]
    }
  },
  "metadata": {
    "author": "Agentic Framework Team",
    "license": "MIT",
    "category": "core",
    "keywords": [
      "framework",
      "infrastructure",
      "agents",
      "skills",
      "discovery"
    ]
  }
}
