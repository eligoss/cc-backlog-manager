{
  "$schema": "./registries/schemas/module.schema.json",
  "id": "core",
  "version": "1.17.0",
  "name": "Framework Core",
  "description": "Core framework infrastructure including framework management agents, shared skills, and essential utilities",
  "provides": {
    "agents": [
      "ai-framework-manager",
      "ai-framework-developer",
      "ai-scout-backlog",
      "ai-scout-codebase",
      "ai-scout-knowledge"
    ],
    "skills": [
      "committing-code",
      "verifying-quality",
      "validating-markdown",
      "using-mcp",
      "building-context",
      "building-skills",
      "using-framework",
      "using-context",
      "validating-links",
      "building-framework",
      "managing-versions",
      "building-agents",
      "gathering-intelligence"
    ],
    "capabilities": [
      "framework-governance",
      "git-workflow-management",
      "jira-integration",
      "jira-git-integration",
      "jira-branch-workflow",
      "quality-assurance",
      "markdown-formatting",
      "mcp-tool-usage",
      "context-authoring",
      "context-validation",
      "skill-creation",
      "framework-architecture-knowledge",
      "context-loading-knowledge",
      "link-validation",
      "version-management",
      "agent-design",
      "framework-development",
      "planning-phases",
      "intelligence-gathering"
    ],
    "scripts": [],
    "guards": [],
    "cli-commands": [
      {
        "name": "validate --links",
        "type": "validate",
        "skill": "validating-links",
        "description": "Validate markdown links in documentation"
      },
      {
        "name": "validate --versions",
        "type": "validate",
        "skill": "managing-versions",
        "description": "Validate version consistency across modules"
      },
      {
        "name": "bump-version",
        "type": "update",
        "skill": "managing-versions",
        "description": "Bump framework version"
      },
      "init",
      "add",
      "remove",
      "list",
      "info",
      "validate",
      "update",
      "status",
      "sync",
      "routes",
      {
        "name": "agent list",
        "type": "query",
        "description": "List all SDK-enabled agents"
      },
      {
        "name": "agent show",
        "type": "query",
        "description": "Show SDK definition for an agent"
      },
      {
        "name": "agent run",
        "type": "execute",
        "description": "Run an agent with Claude Agent SDK"
      }
    ]
  },
  "requires": {},
  "optional-dependencies": [],
  "context": {
    "business": [],
    "technical": [],
    "process": []
  },
  "entry-points": {
    "hooks": {
      "pre-commit": [
        "agentic-framework routes check",
        "agentic-framework validate --links",
        "agentic-framework sync --skills --check",
        "agentic-framework sync --agents --check",
        "agentic-framework validate --versions"
      ]
    },
    "claude-hooks": {
      "SessionStart": [
        {
          "matcher": "startup",
          "scripts": [
            "session-start-worktree.sh",
            "session-start-context.sh"
          ]
        },
        {
          "matcher": "compact",
          "scripts": [
            "session-compact-context.sh"
          ]
        }
      ],
      "SessionEnd": [
        {
          "matcher": ".*",
          "scripts": [
            "session-end-reminder.sh"
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Write|Edit",
          "scripts": [
            "pre-write-quality.sh"
          ]
        },
        {
          "matcher": "Bash",
          "scripts": [
            "pre-commit-skill-reminder.sh",
            "pre-bash-safety.sh"
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Write|Edit",
          "scripts": [
            "post-write-validate.sh",
            "post-write-format.sh"
          ]
        }
      ],
      "SubagentStart": [
        {
          "matcher": ".*",
          "scripts": [
            "subagent-context-loader.sh",
            "skill-reminder.sh"
          ]
        }
      ],
      "Stop": [
        {
          "matcher": ".*",
          "scripts": [
            "stop-quality-check.sh",
            "stop-commit-check.sh",
            "stop-pr-suggest.sh"
          ]
        }
      ],
      "Notification": [
        {
          "matcher": "permission_prompt|idle_prompt",
          "scripts": [
            "notify.sh"
          ]
        }
      ]
    }
  },
  "metadata": {
    "author": "Agentic Framework Team",
    "license": "MIT",
    "category": "core",
    "keywords": [
      "framework",
      "infrastructure",
      "agents",
      "skills",
      "discovery"
    ]
  }
}
