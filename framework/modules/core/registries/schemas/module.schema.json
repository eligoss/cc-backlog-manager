{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-framework.dev/schemas/module.schema.json",
  "title": "Agentic Framework Module",
  "description": "Schema for module.json manifest files that define framework modules",
  "type": "object",
  "required": ["id", "version", "name", "description", "provides"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 2,
      "maxLength": 30,
      "description": "Unique module identifier (kebab-case)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g., 1.0.0)"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 50,
      "description": "Human-readable module name"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "Brief description of module purpose"
    },
    "provides": {
      "type": "object",
      "description": "What this module provides to the framework",
      "additionalProperties": false,
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ai-[a-z][a-z0-9-]*$"
          },
          "description": "Agent IDs provided by this module"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": "Skill IDs provided by this module"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": "Capability IDs this module makes available"
        },
        "scripts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "DEPRECATED: Python scripts (use cli-commands instead)"
        },
        "guards": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "DEPRECATED: Pre-commit guard scripts (use entry-points.hooks instead)"
        },
        "directories": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9\\-_/]*$"
          },
          "description": "Root-level project directories to create during init/add (relative to project root)"
        },
        "cli-commands": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "Simple command name (legacy format)"
              },
              {
                "type": "object",
                "required": ["name", "type"],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Full command name (e.g., 'planning create-plan')"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["create", "validate", "sync", "transform", "export", "import", "migrate", "update", "fetch", "query", "execute"],
                    "description": "Command type category"
                  },
                  "skill": {
                    "type": "string",
                    "description": "Skill ID that implements this command (optional for query/execute types)"
                  },
                  "template": {
                    "type": "string",
                    "description": "Template file used by create commands"
                  },
                  "schema": {
                    "type": "string",
                    "description": "JSON Schema file used by validate commands"
                  },
                  "description": {
                    "type": "string",
                    "description": "Human-readable command description"
                  }
                },
                "description": "Structured command definition linking to implementing skill"
              }
            ]
          },
          "description": "CLI commands provided by this module via agentic-framework CLI"
        }
      }
    },
    "requires": {
      "type": "object",
      "description": "Required module dependencies with version constraints",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(>=|>|=|<|<=)?\\d+\\.\\d+\\.\\d+$"
      }
    },
    "optional-dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "description": "Optional modules that enhance functionality if present"
    },
    "entry-points": {
      "type": "object",
      "description": "CLI entry points and scripts",
      "additionalProperties": false,
      "properties": {
        "cli": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "script"],
            "properties": {
              "name": { "type": "string" },
              "script": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "hooks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pre-commit": { "type": "array", "items": { "type": "string" } },
            "post-commit": { "type": "array", "items": { "type": "string" } },
            "pre-push": { "type": "array", "items": { "type": "string" } }
          }
        },
        "claude-hooks": {
          "type": "object",
          "description": "Claude Code hook configurations by event type",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["matcher", "scripts"],
              "additionalProperties": false,
              "properties": {
                "matcher": {
                  "type": "string",
                  "description": "Regex pattern to match against hook event context"
                },
                "scripts": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Shell script filenames in the module's hooks/ directory"
                }
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional module metadata",
      "properties": {
        "author": { "type": "string" },
        "license": { "type": "string" },
        "repository": { "type": "string", "format": "uri" },
        "homepage": { "type": "string", "format": "uri" },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "category": {
          "type": "string",
          "enum": ["core", "integration", "workflow", "development", "documentation"]
        }
      }
    }
  }
}
